# Telegram Bot
BOT_TOKEN=your-telegram-bot-token

# Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your-64-char-hex-string

# AWS (optional — Lambda gets these from IAM role, only needed for local dev)
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=DailyChineseBot

# Webhook security (must match the secret_token registered with Telegram)
WEBHOOK_SECRET=your-webhook-secret

# CloudWatch alarm notifications (used at CDK deploy time, not Lambda runtime)
ALARM_EMAIL=you@example.com

# Optional: override for local development
# LOG_LEVEL=debug
